rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Refus par défaut : toute collection non explicitement autorisée
    // ci-dessous est inaccessible, y compris en lecture.
    match /{document=**} {
      allow read, write: if false;
    }

    // Un utilisateur connecté est-il membre actif du foyer "code" ?
    function isActiveHouseholdMember(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.status == 'active';
    }

    // Un utilisateur connecté est-il ADMIN actif du foyer "code" ?
    function isActiveHouseholdAdmin(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.role == 'admin';
    }

    // Le champ isSuperAdmin vit sur le document users/{uid} — une seule
    // lecture suffit, pas de collection séparée à interroger.
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // ─── users/{uid} ───────────────────────────────────────────────
    // Profil de base : email, statut super-admin global. Un utilisateur
    // ne peut lire/créer/modifier QUE son propre document. Inscription
    // libre (self-service) autorisée, mais impossible de s'auto-déclarer
    // super-admin, et impossible de modifier email/isSuperAdmin après
    // création via ce chemin.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.isSuperAdmin != true;

      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.isSuperAdmin == resource.data.isSuperAdmin;

      allow delete: if false;

      // ─── users/{uid}/memberships/{code} ──────────────────────────
      // Une adhésion active à un foyer = un document. AUCUNE création ni
      // modification directe par le titulaire ou un tiers quelconque :
      // seule l'approbation d'une demande (par un admin du foyer
      // concerné) peut créer ou activer une adhésion, et toujours avec
      // role "member" — jamais "admin" par ce chemin (attribution admin
      // = geste manuel Console, voir runbook.md). Le titulaire peut
      // seulement LIRE ses propres adhésions.
      match /memberships/{code} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null &&
          isActiveHouseholdAdmin(code) &&
          request.resource.data.role == 'member' &&
          (request.resource.data.status == 'active' || request.resource.data.status == 'disabled');

        allow delete: if false;
      }
    }

    // ─── {any}/membershipRequests/{code} (collection group) ─────────
    // Une demande d'adhésion = un document sous users/{uid}/membershipRequests/{code},
    // mais interrogée en "collection group" (tous utilisateurs confondus)
    // par un admin de foyer qui doit voir les demandes le concernant.
    // Champs attendus : { uid, code, status: "pending"|"approved"|"rejected", requestedAt }.
    // uid et code sont dupliqués dans le document (en plus du chemin) car
    // une requête "collection group" ne peut pas facilement filtrer sur
    // les segments du chemin — seulement sur des champs.
    match /{path=**}/membershipRequests/{reqId} {
      // Le demandeur peut lire ses propres demandes (statut de sa demande).
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // Un admin (ou super-admin) du foyer concerné peut lire les
      // demandes qui LUI sont adressées (liste des demandes en attente).
      allow read: if isActiveHouseholdAdmin(resource.data.code) || isSuperAdmin();

      // Créer sa PROPRE demande, uniquement "pending", uniquement pour un
      // foyer qui existe déjà, uniquement si on n'a pas déjà une adhésion
      // active pour ce foyer (évite les demandes redondantes), et l'ID du
      // document doit correspondre au code visé (cohérence chemin/champ).
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid &&
        reqId == request.resource.data.code &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/groupes/$(request.resource.data.code)) &&
        !isActiveHouseholdMember(request.resource.data.code);

      // Faire évoluer une demande (accepter/refuser) : réservé à un admin
      // du foyer concerné — JAMAIS le demandeur lui-même, même s'il
      // devient admin par ailleurs entre-temps (uid/code ne peuvent pas
      // changer, seul le statut peut passer à approved/rejected).
      allow update: if isActiveHouseholdAdmin(resource.data.code) &&
        request.auth.uid != resource.data.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.status in ['approved', 'rejected'];

      allow delete: if isActiveHouseholdAdmin(resource.data.code) || isSuperAdmin();
    }

    // ─── groupes/{code} ──────────────────────────────────────────────
    match /groupes/{code} {
      // Un membre actif du foyer peut LIRE son propre foyer. Le
      // super-admin peut lire n'importe quel foyer (panneau global).
      allow get: if isActiveHouseholdMember(code) || isSuperAdmin();
      allow list: if isSuperAdmin(); // liste complète réservée au panneau admin global

      // MODIFIER le document principal du foyer : réservé à un admin
      // actif de CE foyer, ou au super-admin. Un simple membre ne peut
      // plus écrire dessus (durci suite à revue sécurité).
      allow update: if isActiveHouseholdAdmin(code) || isSuperAdmin();

      allow create, delete: if false; // création de foyer : hors périmètre de ce sprint (Console)

      // Sous-collections métier : accessibles à tout membre actif
      // (lecture ET écriture), inchangé — c'est là que vit l'usage
      // quotidien (agenda, mur, dîner), pas sur le document principal.
      match /events/{eventId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /mur/{msgId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /diner/{dateKey} {
        allow read, write: if isActiveHouseholdMember(code);
      }
    }
  }
}
