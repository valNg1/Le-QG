rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Refus par défaut : toute collection non explicitement autorisée
    // ci-dessous est inaccessible, y compris en lecture.
    match /{document=**} {
      allow read, write: if false;
    }

    // Un utilisateur connecté est-il membre actif du foyer "code" ?
    function isActiveHouseholdMember(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.status == 'active';
    }

    // Un utilisateur connecté est-il ADMIN actif du foyer "code" ?
    function isActiveHouseholdAdmin(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.role == 'admin';
    }

    // Le champ isSuperAdmin vit sur le document users/{uid} — une seule
    // lecture suffit, pas de collection séparée à interroger.
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // ─── users/{uid} ───────────────────────────────────────────────
    // Profil de base : email, statut super-admin global. Un utilisateur
    // ne peut lire/créer/modifier QUE son propre document. Inscription
    // libre (self-service) autorisée, mais impossible de s'auto-déclarer
    // super-admin, et impossible de modifier email/isSuperAdmin après
    // création via ce chemin.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.isSuperAdmin != true;

      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.isSuperAdmin == resource.data.isSuperAdmin;

      allow delete: if false;

      // ─── users/{uid}/data/{docId} ─────────────────────────────────
      // Stockage personnel générique, strictement privé au titulaire du
      // compte (tâches perso, et toute future donnée purement
      // individuelle) — sauvegarde serveur pour survivre à une perte du
      // stockage local de l'appareil.
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // ─── users/{uid}/memberships/{code} ──────────────────────────
      // Une adhésion active à un foyer = un document.
      //
      // CRÉATION : réservée à un admin du foyer, uniquement role
      // "member", uniquement les champs role+status (keys().hasOnly —
      // aucun champ additionnel ne peut être glissé dans le document),
      // et — verrou d'atomicité — la demande correspondante DOIT être en
      // train de passer à "approved" dans le MÊME batch (getAfter sur
      // membershipRequests/{code}). Impossible de créer une adhésion
      // active sans que la demande soit simultanément approuvée.
      //
      // MISE À JOUR (ex. désactiver un membre existant) : le rôle est
      // immuable (doit rester identique à l'existant), seul le statut
      // peut basculer active/disabled — pas de lien à une demande ici,
      // c'est une action de gestion directe par l'admin sur une adhésion
      // qui existe déjà.
      match /memberships/{code} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null &&
          isActiveHouseholdAdmin(code) &&
          request.resource.data.keys().hasOnly(['role', 'status']) &&
          request.resource.data.role == 'member' &&
          request.resource.data.status == 'active' &&
          getAfter(/databases/$(database)/documents/users/$(uid)/membershipRequests/$(code)).data.status == 'approved';

        allow update: if request.auth != null &&
          isActiveHouseholdAdmin(code) &&
          request.resource.data.keys().hasOnly(['role', 'status']) &&
          request.resource.data.role == resource.data.role &&
          (request.resource.data.status == 'active' || request.resource.data.status == 'disabled');

        allow delete: if false;
      }

      // ─── users/{uid}/membershipRequests/{code} ───────────────────
      // Chemin STRICTEMENT limité à users/{uid}/membershipRequests/{code}
      // (imbriqué dans le match users/{uid}, pas de wildcard
      // "{path=**}"). uid et code sont des VARIABLES DE CHEMIN,
      // garanties par la structure du document — pas de simples champs
      // qu'on pourrait falsifier dans le contenu écrit.
      match /membershipRequests/{code} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Un admin (ou super-admin) du foyer concerné peut lire les
        // demandes qui LUI sont adressées. Cette règle s'applique aussi
        // aux requêtes "collection group" : Firestore l'évalue document
        // par document, donc une requête admin ne peut jamais voir les
        // demandes d'un foyer dont il n'est pas admin, même s'il tente
        // d'élargir sa requête côté client (l'app elle-même limite déjà
        // chaque requête à un seul "code" à la fois — voir
        // loadPendingRequests() dans index.html — mais la garantie
        // réelle vient d'ici, pas du client).
        allow read: if isActiveHouseholdAdmin(code) || isSuperAdmin();

        // Créer sa PROPRE demande (uid = soi-même, imposé par le chemin),
        // en cohérence stricte chemin/contenu (uid et code du document
        // DOIVENT correspondre exactement aux variables de chemin),
        // uniquement "pending", uniquement pour un foyer qui existe déjà,
        // uniquement si on n'a pas déjà une adhésion active pour ce foyer.
        allow create: if request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.code == code &&
          request.resource.data.status == 'pending' &&
          exists(/databases/$(database)/documents/groupes/$(code)) &&
          !isActiveHouseholdMember(code);

        // Faire évoluer une demande (accepter/refuser) : réservé à un
        // admin du foyer concerné — JAMAIS le demandeur lui-même.
        // Immutabilité stricte : uid, code, requestedAt ne peuvent pas
        // changer, et diff().affectedKeys().hasOnly(['status']) interdit
        // tout autre champ, même un champ pas encore imaginé aujourd'hui.
        // Verrou d'atomicité (miroir de celui sur memberships ci-dessus) :
        // si le statut passe à "approved", l'adhésion correspondante DOIT
        // être en train d'être créée/activée dans le MÊME batch (getAfter
        // sur memberships/{code}) — impossible d'approuver sans que
        // l'adhésion soit simultanément créée. Un refus n'a pas cette
        // contrainte (aucune adhésion à créer).
        allow update: if isActiveHouseholdAdmin(code) &&
          request.auth.uid != uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.requestedAt == resource.data.requestedAt &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          (request.resource.data.status == 'rejected' ||
            (
              getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(code)).data.role == 'member' &&
              getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(code)).data.status == 'active'
            )
          );

        allow delete: if isActiveHouseholdAdmin(code) || isSuperAdmin();
      }
    }

    // ─── groupes/{code} ──────────────────────────────────────────────
    match /groupes/{code} {
      // Un membre actif du foyer peut LIRE son propre foyer. Le
      // super-admin peut lire n'importe quel foyer (panneau global).
      allow get: if isActiveHouseholdMember(code) || isSuperAdmin();
      allow list: if isSuperAdmin(); // liste complète réservée au panneau admin global

      // MODIFIER le document principal du foyer : réservé à un admin
      // actif de CE foyer, ou au super-admin.
      allow update: if isActiveHouseholdAdmin(code) || isSuperAdmin();

      allow create, delete: if false; // création de foyer : hors périmètre de ce sprint (Console)

      // Sous-collections métier : accessibles à tout membre actif
      // (lecture ET écriture) — c'est là que vit l'usage quotidien
      // (agenda, mur, dîner), pas sur le document principal.
      match /events/{eventId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /mur/{msgId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /diner/{dateKey} {
        allow read, write: if isActiveHouseholdMember(code);
      }

      // Profil live de chaque membre (prénom/avatar). Chaque personne
      // écrit UNIQUEMENT son propre document — jamais celui d'un autre —
      // ce qui tient à jour la liste "Membres" sans jamais toucher au
      // document principal du foyer (réservé aux admins ci-dessus).
      match /members/{uid} {
        allow read: if isActiveHouseholdMember(code);
        allow create, update: if request.auth != null && request.auth.uid == uid && isActiveHouseholdMember(code);
        allow delete: if false;
      }
    }
  }
}
