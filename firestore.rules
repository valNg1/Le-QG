rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Refus par défaut : toute collection non explicitement autorisée
    // ci-dessous est inaccessible, y compris en lecture.
    match /{document=**} {
      allow read, write: if false;
    }

    // Un utilisateur connecté est-il membre actif du foyer "code" ?
    function isActiveHouseholdMember(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.status == 'active';
    }

    // Un utilisateur connecté est-il ADMIN actif du foyer "code" ?
    function isActiveHouseholdAdmin(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(code)).data.role == 'admin';
    }

    // Le champ isSuperAdmin vit sur le document users/{uid} — une seule
    // lecture suffit, pas de collection séparée à interroger.
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // ─── users/{uid} ───────────────────────────────────────────────
    // Profil de base : email, statut super-admin global. Un utilisateur
    // ne peut lire/créer/modifier QUE son propre document. Inscription
    // libre (self-service) autorisée, mais impossible de s'auto-déclarer
    // super-admin, et impossible de modifier email/isSuperAdmin après
    // création via ce chemin.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.isSuperAdmin != true;

      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.isSuperAdmin == resource.data.isSuperAdmin;

      allow delete: if false;

      // ─── users/{uid}/memberships/{code} ──────────────────────────
      // Une adhésion active à un foyer = un document. AUCUNE création ni
      // modification par le titulaire lui-même : seule l'approbation
      // d'une demande (par un admin du foyer concerné) peut créer ou
      // activer une adhésion, et toujours avec role "member" — jamais
      // "admin" par ce chemin (attribution admin = geste manuel
      // Console, voir runbook.md). Le titulaire peut seulement LIRE ses
      // propres adhésions.
      match /memberships/{code} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null &&
          isActiveHouseholdAdmin(code) &&
          request.resource.data.role == 'member' &&
          (request.resource.data.status == 'active' || request.resource.data.status == 'disabled');

        allow delete: if false;
      }

      // ─── users/{uid}/membershipRequests/{code} ───────────────────
      // Chemin STRICTEMENT limité à users/{uid}/membershipRequests/{code}
      // (imbriqué dans le match users/{uid} ci-dessus, pas de wildcard
      // "{path=**}" — corrigé suite à revue sécurité : un chemin trop
      // large aurait potentiellement permis de créer une demande
      // n'importe où se terminant par "membershipRequests/{reqId}").
      // uid et code sont ici des VARIABLES DE CHEMIN, garanties par la
      // structure du document lui-même — pas de simples champs qu'on
      // pourrait tenter de falsifier dans le contenu écrit.
      match /membershipRequests/{code} {
        // Le demandeur peut lire ses propres demandes.
        allow read: if request.auth != null && request.auth.uid == uid;
        // Un admin (ou super-admin) du foyer concerné peut lire les
        // demandes qui LUI sont adressées (liste des demandes en
        // attente) — cette règle s'applique aussi aux requêtes
        // "collection group" utilisées par l'app pour lister toutes les
        // demandes d'un foyer tous utilisateurs confondus : Firestore
        // évalue cette règle document par document, donc chaque demande
        // n'est renvoyée que si l'admin qui interroge est bien admin du
        // foyer "code" de CE document précis.
        allow read: if isActiveHouseholdAdmin(code) || isSuperAdmin();

        // Créer sa PROPRE demande (uid = soi-même, imposé par la
        // structure du chemin), en cohérence stricte entre le chemin et
        // le contenu du document (uid et code du contenu DOIVENT
        // correspondre exactement aux variables de chemin — empêche
        // toute demande usurpant l'identité d'un autre uid ou visant un
        // autre foyer que celui du chemin), uniquement "pending",
        // uniquement pour un foyer qui existe déjà, uniquement si on
        // n'a pas déjà une adhésion active pour ce foyer.
        allow create: if request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.code == code &&
          request.resource.data.status == 'pending' &&
          exists(/databases/$(database)/documents/groupes/$(code)) &&
          !isActiveHouseholdMember(code);

        // Faire évoluer une demande (accepter/refuser) : réservé à un
        // admin du foyer concerné — JAMAIS le demandeur lui-même.
        // Immutabilité stricte de l'identité de la demande : uid, code
        // et requestedAt ne peuvent PAS changer, seul le champ status
        // peut passer à approved/rejected. Aucun autre champ ne peut
        // être ajouté ou modifié par ce chemin.
        allow update: if isActiveHouseholdAdmin(code) &&
          request.auth.uid != uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.requestedAt == resource.data.requestedAt &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

        allow delete: if isActiveHouseholdAdmin(code) || isSuperAdmin();
      }
    }

    // ─── groupes/{code} ──────────────────────────────────────────────
    match /groupes/{code} {
      // Un membre actif du foyer peut LIRE son propre foyer. Le
      // super-admin peut lire n'importe quel foyer (panneau global).
      allow get: if isActiveHouseholdMember(code) || isSuperAdmin();
      allow list: if isSuperAdmin(); // liste complète réservée au panneau admin global

      // MODIFIER le document principal du foyer : réservé à un admin
      // actif de CE foyer, ou au super-admin.
      allow update: if isActiveHouseholdAdmin(code) || isSuperAdmin();

      allow create, delete: if false; // création de foyer : hors périmètre de ce sprint (Console)

      // Sous-collections métier : accessibles à tout membre actif
      // (lecture ET écriture) — c'est là que vit l'usage quotidien
      // (agenda, mur, dîner), pas sur le document principal.
      match /events/{eventId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /mur/{msgId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /diner/{dateKey} {
        allow read, write: if isActiveHouseholdMember(code);
      }
    }
  }
}
