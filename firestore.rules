rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Refus par défaut : toute collection non explicitement autorisée
    // ci-dessous est inaccessible, y compris en lecture.
    match /{document=**} {
      allow read, write: if false;
    }

    // Un utilisateur connecté est-il membre actif du foyer "code" ?
    function isActiveHouseholdMember(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == code &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Un utilisateur connecté est-il ADMIN actif du foyer "code" ?
    // (utilisé pour autoriser la création de nouveaux membres)
    function isActiveHouseholdAdmin(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == code &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Le champ isSuperAdmin vit sur le document users/{uid} — une seule
    // lecture suffit, pas de collection séparée à interroger.
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // ─── users/{uid} ───────────────────────────────────────────────
    // Source de vérité unique : rattachement compte Firebase -> foyer,
    // rôle de foyer (admin/member) ET statut super-admin global
    // (isSuperAdmin, remplace l'ancien mot de passe "2601" côté client).
    // Un utilisateur ne peut lire QUE son propre document.
    //
    // Écriture : aucune inscription publique (un visiteur ne peut jamais
    // créer son propre document — request.auth.uid != uid l'interdit).
    // Seul un admin de foyer déjà actif peut provisionner un NOUVEAU
    // membre pour SON PROPRE foyer — jamais un autre foyer, jamais avec
    // role != "member", jamais super-admin. Le compte admin lui-même
    // (premier compte de chaque foyer) reste créé à la main dans la
    // Firebase Console (voir runbook.md).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null &&
        request.auth.uid != uid &&
        isActiveHouseholdAdmin(request.resource.data.householdId) &&
        request.resource.data.role == 'member' &&
        request.resource.data.status == 'active' &&
        request.resource.data.isSuperAdmin != true;

      allow update, delete: if false;
    }

    // ─── groupes/{code} ──────────────────────────────────────────────
    match /groupes/{code} {
      // Un membre actif du foyer peut lire/modifier son propre foyer.
      // Le super-admin peut lire n'importe quel foyer (panneau
      // d'administration global) et le suspendre/réactiver.
      allow get: if isActiveHouseholdMember(code) || isSuperAdmin();
      allow list: if isSuperAdmin(); // liste complète réservée au panneau admin global
      allow update: if isActiveHouseholdMember(code) || isSuperAdmin();
      allow create, delete: if false; // création/suppression de foyer : Console uniquement

      match /events/{eventId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /mur/{msgId} {
        allow read, write: if isActiveHouseholdMember(code);
      }
      match /diner/{dateKey} {
        allow read, write: if isActiveHouseholdMember(code);
      }
    }
  }
}
